load("//:tools/bazel/GenTestRules.bzl", "run_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(
        ["**/*.java"],
        exclude = [
            "datasourcelocations/client/**/*.java",
            "datapointsdata/resource/**/*.java",
            "scorecards/mappers/**/*.java",
            "scorecards/repositories/**/*.java",
            "tiergroups/config/**/*.java",
            "tiergroups/resources/**/*.java",
            "tiergroups/service/**/*.java",
        ],
    ),
    data = [
        "//idp-service/src/test/resources:resource",
    ],
    resources = [
        "//idp-service/src/main/resources:resource",
        "//idp-service/src/test/resources:resource",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//990-commons-test:module",
        "//idp-service/src/main/java/io/harness/idp/scorecard:module",
        "//idp-service/src/test/java/io/harness/idp/scorecard/datasourcelocations/client:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/datasourcelocations/mappers:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/datasources/cache:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/scorecards/mappers:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/scorecards/repositories:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/tiergroups/config:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/tiergroups/resources:tests",
        "//idp-service/src/test/java/io/harness/idp/scorecard/tiergroups/service:tests",
        "@maven//:org_mockito_mockito_inline",
    ],
)

run_tests("**/*Test.java")
