        "//idp-service/src/main/java/io/harness/idp/audittrails:module",
        "//idp-service/src/main/java/io/harness/idp/backstage:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/events:module",
        "//idp-service/src/main/java/io/harness/idp/ccp/events:module",
