load("//:tools/bazel/GenTestRules.bzl", "run_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["**/*.java"]),
    data = [
        "//idp-service/src/test/resources:resource",
    ],
    resources = [
        "//idp-service/src/test/resources:resource",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//990-commons-test/src/main/java/io/harness:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//idp-service/contracts/openapi/v1:idp-service-server-spec-module",
        "//idp-service/src/main/java/io/harness/idp/catalog/beans:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/entities:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/strategy:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/utils:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_yaml_snakeyaml",
    ],
)

run_tests("**/*Test.java")
