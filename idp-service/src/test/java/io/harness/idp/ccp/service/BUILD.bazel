load("//:tools/bazel/GenTestRules.bzl", "run_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["**/*.java"]),
    data = [
        "//idp-service/src/test/resources:resource",
    ],
    resources = [
        "//idp-service/src/test/resources:resource",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//960-persistence/src/main/java/io/harness/lock/interfaces:module",
        "//960-persistence/src/main/java/io/harness/lock/redis:module",
        "//990-commons-test:module",
        "//990-commons-test/src/main/java/io/harness/category:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/entities:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/repositories:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/utils:module",
        "//idp-service/src/main/java/io/harness/idp/ccp/service:module",
        "//idp-service/src/main/java/io/harness/idp/common:module",
        "//idp-service/src/main/java/io/harness/idp/events/utils:module",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_inline",
    ],
)

run_tests("**/*Test.java")
