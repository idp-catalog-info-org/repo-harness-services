{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/jfrog-artifactory-proxy-schema.json",
  "title": "JFrog Artifactory Proxy Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxy"
  ],
  "properties": {
    "proxy": {
      "$id": "#root/proxy",
      "title": "Proxy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "$id": "#root/proxy/endpoints",
          "title": "Endpoints",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/jfrog-artifactory/api"
          ],
          "properties": {
            "/jfrog-artifactory/api": {
              "$id": "#root/proxy/endpoints//jfrog-artifactory/api",
              "title": "/jfrog-artifactory/api",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "headers",
                "secure",
                "pathRewrite"
              ],
              "properties": {
                "target": {
                  "$id": "#root/proxy/endpoints//jfrog-artifactory/api/target",
                  "title": "Target",
                  "type": "string",
                  "default": "https://harnessio.jfrog.io/",
                  "pattern": "((http|https)://)(www.)?[a-zA-Z0-9-@:%._\\+~#?&//=]{2,256}\\.[a-z]{2,63}\\b([-a-zA-Z0-9@:%._\\+~#?&//=]*)"
                },
                "headers": {
                  "$id": "#root/proxy/endpoints//jfrog-artifactory/api/headers",
                  "title": "Headers",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "Authorization"
                  ],
                  "properties": {
                    "Authorization": {
                      "$id": "#root/proxy/endpoints//jfrog-artifactory/api/headers/Authorization",
                      "title": "Authorization",
                      "type": "string",
                      "default": "Bearer ${TOKEN}",
                      "pattern": "^.*$"
                    }
                  }
                },
                "secure": {
                  "$id": "#root/proxy/endpoints//jfrog-artifactory/api/secure",
                  "title": "Secure",
                  "type": "boolean",
                  "default": true,
                  "description": "Set to false if using a self-hosted Artifactory instance with a self-signed certificate."
                },
                "pathRewrite": {
                  "$id": "#root/proxy/endpoints//jfrog-artifactory/api/pathRewrite",
                  "title": "PathRewrite",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "api/proxy/jfrog-artifactory/api/?"
                  ],
                  "properties": {
                    "api/proxy/jfrog-artifactory/api/?": {
                      "$id": "#root/proxy/endpoints//jfrog-artifactory/api/pathRewrite/api/proxy/jfrog-artifactory/api/?",
                      "title": "Api/proxy/jfrog-artifactory/api/?",
                      "type": "string",
                      "default": "/",
                      "pattern": "^.*$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
