{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/dx-schema.json",
  "title": "Root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxy"
  ],
  "properties": {
    "proxy": {
      "$id": "#root/proxy",
      "title": "Proxy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "$id": "#root/proxy/endpoints",
          "title": "Endpoints",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/dx-web-api"
          ],
          "properties": {
            "/dx-web-api": {
              "$id": "#root/proxy/endpoints//dx-web-api",
              "title": "/dx-web-api",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "pathRewrite",
                "headers",
                "allowedHeaders"
              ],
              "properties": {
                "target": {
                  "$id": "#root/proxy/endpoints//dx-web-api/target",
                  "title": "Target",
                  "type": "string",
                  "pattern": "((http|https)://)(www.)?[a-zA-Z0-9-@:%._\\+~#?&//=]{2,256}\\.[a-z]{2,63}\\b([-a-zA-Z0-9@:%._\\+~#?&//=]*)"
                },
                "pathRewrite": {
                  "$id": "#root/proxy/endpoints//dx-web-api/pathRewrite",
                  "title": "Path Rewrite",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "/api/proxy/dx-web-api/?"
                  ],
                  "properties": {
                    "/api/proxy/dx-web-api/?": {
                        "$id": "#root/proxy/endpoints//dx-web-api/pathRewrite//api/proxy/dx-web-api/?",
                        "title": "/api/proxy/dx-web-api/?",
                        "type": "string",
                        "default": "",
                        "pattern": "^.*$"
                    }
                  }
                },
                "headers": {
                  "$id": "#root/proxy/endpoints//dx-web-api/headers",
                  "title": "Headers",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "Authorization"
                  ],
                  "title": "Authorization",
                  "properties": {
                    "Authorization": {
                      "$id": "#root/proxy/endpoints//dx-web-api/headers/Authorization",
                      "title": "Authorization",
                      "type": "string",
                      "default": "Bearer ${DX_TOKEN}",
                      "pattern": "^.*$"
                    }
                  }
                },
                "allowedHeaders": {
                  "$id": "#root/proxy/endpoints//dx-web-api/allowedHeaders",
                  "title": "Allowed Headers",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "default": [],
                    "enum": [
                      "X-Client-Type",
                      "X-Client-Version"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "dx": {
      "$id": "#root/dx",
      "title": "Dx",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "string",
          "additionalProperties": false
        }
      }
    }
   }
  }
