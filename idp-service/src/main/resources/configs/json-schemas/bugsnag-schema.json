{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/object1707813580.json",
  "title": "Root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxy"
  ],
  "properties": {
    "proxy": {
      "$id": "#root/proxy",
      "title": "Proxy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "$id": "#root/proxy/endpoints",
          "title": "Endpoints",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/bugsnag/api"
          ],
          "properties": {
            "/bugsnag/api": {
              "$id": "#root/proxy/endpoints//bugsnag/api",
              "title": "/bugsnag/api",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "pathRewrite",
                "headers"
              ],
              "properties": {
                "target": {
                  "$id": "#root/proxy/endpoints//bugsnag/api/target",
                  "title": "Target",
                  "type": "string",
                  "default": "https://api.bugsnag.com",
                  "pattern": "((http|https)://)(www.)?[a-zA-Z0-9-@:%._\\+~#?&//=]{2,256}\\.[a-z]{2,63}\\b([-a-zA-Z0-9@:%._\\+~#?&//=]*)"
                },
                "pathRewrite": {
                  "$id": "#root/proxy/endpoints//bugsnag/api/pathRewrite",
                  "title": "PathRewrite",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "api/proxy/bugsnag/api?"
                  ],
                  "properties": {
                    "api/proxy/bugsnag/api?": {
                      "$id": "#root/proxy/endpoints//bugsnag/api/pathRewrite/api/proxy/bugsnag/api?",
                      "title": "api/proxy/bugsnag/api?",
                      "type": "string",
                      "default": "/",
                      "pattern": "^.*$"
                    }
                  }
                },
                "headers": {
                  "$id": "#root/proxy/endpoints//bugsnag/api/headers",
                  "title": "Headers",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "Authorization",
                    "X-version"
                  ],
                  "properties": {
                    "Authorization": {
                      "$id": "#root/proxy/endpoints//bugsnag/api/headers/Authorization",
                      "title": "Authorization",
                      "type": "string",
                      "default": "${BUGSNAG_PERSONAL_TOKEN}",
                      "pattern": "^.*$"
                    },
                    "X-version": {
                      "$id": "#root/proxy/endpoints//bugsnag/api/headers/X-version",
                      "title": "X-version",
                      "type": "string",
                      "default": "2",
                      "pattern": "^[0-9]+$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
