                      "initialDelay": {
                        "$id": "#root/catalog/providers/github/providerId/schedule/initialDelay",
                        "title": "InitialDelay",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "seconds": {
                            "$id": "#root/catalog/providers/github/providerId/schedule/initialDelay/seconds",
                            "title": "Seconds",
                            "type": "number",
                            "minimum": 120,
                            "default": 120
                          }
                        }
                      }
                    }
                  }
                }
              }
            }

          }
        }

      }
    }

  }
}
