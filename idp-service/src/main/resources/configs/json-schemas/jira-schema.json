{
  "definitions": {

  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/object1707809541.json",
  "title": "Root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxy"
  ],
  "properties": {
    "proxy": {
      "$id": "#root/proxy",
      "title": "Proxy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "$id": "#root/proxy/endpoints",
          "title": "Endpoints",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/jira/api"
          ],
          "properties": {
            "/jira/api": {
              "$id": "#root/proxy/endpoints//jira/api",
              "title": "/jira/api",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "pathRewrite",
                "headers"
              ],
              "properties": {
                "target": {
                  "$id": "#root/proxy/endpoints//jira/api/target",
                  "title": "Target",
                  "type": "string",
                  "default": "",
                  "pattern": "((http|https)://)(www.)?[a-zA-Z0-9-@:%._\\+~#?&//=]{2,256}\\.[a-z]{2,63}\\b([-a-zA-Z0-9@:%._\\+~#?&//=]*)"
                },
                "pathRewrite": {
                  "$id": "#root/proxy/endpoints//jira/api/pathRewrite",
                  "title": "Pathrewrite",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "api/proxy/jira/api/?"
                  ],
                  "properties": {
                    "api/proxy/jira/api/?": {
                      "$id": "#root/proxy/endpoints//jira/api/pathRewrite/api/proxy/jira/api/?",
                      "title": "Api/proxy/jira/api/?",
                      "type": "string",
                      "default": "",
                      "pattern": "^.*$"
                    }
                  }
                },
                "headers": {
                  "$id": "#root/proxy/endpoints//jira/api/headers",
                  "title": "Headers",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "Authorization",
                    "Accept",
                    "Content-Type",
                    "X-Atlassian-Token",
                    "User-Agent"
                  ],
                  "properties": {
                    "Authorization": {
                      "$id": "#root/proxy/endpoints//jira/api/headers/Authorization",
                      "title": "Authorization",
                      "type": "string",
                      "default": "",
                      "pattern": "^.*$"
                    },
                    "Accept": {
                      "$id": "#root/proxy/endpoints//jira/api/headers/Accept",
                      "title": "Accept",
                      "type": "string",
                      "default": "",
                      "pattern": "^.*$"
                    },
                    "Content-Type": {
                      "$id": "#root/proxy/endpoints//jira/api/headers/Content-Type",
                      "title": "Content-type",
                      "type": "string",
                      "default": "",
                      "pattern": "^.*$"
                    },
                    "X-Atlassian-Token": {
                      "$id": "#root/proxy/endpoints//jira/api/headers/X-Atlassian-Token",
                      "title": "X-atlassian-token",
                      "type": "string",
                      "default": "",
                      "pattern": "^.*$"
                    },
                    "User-Agent": {
                      "$id": "#root/proxy/endpoints//jira/api/headers/User-Agent",
                      "title": "User-agent",
                      "type": "string",
                      "default": "",
                      "pattern": "^.*$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "jira": {
      "$id": "#root/jira",
      "title": "Jira",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxyPath": {
          "$id": "#root/jira/proxyPath",
          "title": "proxyPath",
          "type": "string",
          "default": "/jira/api"
        },
        "confluenceActivityFilter": {
          "$id": "#root/jira/confluenceActivityFilter",
          "title": "confluenceActivityFilter",
          "type": "string"
        },
        "apiVersion": {
          "$id": "#root/jira/apiVersion",
          "title": "apiVersion",
          "type": "integer"
        },
        "product": {
          "$id": "#root/jira/product",
          "title": "product",
          "type": "string",
          "enum": ["cloud", "datacenter"],
          "default": "cloud"
        }
      }
    }
  }
}
