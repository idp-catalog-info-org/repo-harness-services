{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/proxy-schema.json",
  "title": "Root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proxy"
  ],
  "properties": {
    "proxy": {
      "$id": "#root/proxy",
      "title": "Proxy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "$id": "#root/proxy/endpoints",
          "title": "Endpoints",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/harness/prod"
          ],
          "properties": {
            "/harness": {
              "$id": "#root/proxy/endpoints//harness/prod",
              "title": "/harness/prod",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "pathRewrite",
                "allowedHeaders"
              ],
              "properties": {
                "target": {
                  "$id": "#root/proxy/endpoints//harness/prod/target",
                  "title": "Target",
                  "type": "string",
                  "format": "uri",
                  "default": "",
                  "pattern": "((http|https)://)(www.)?[a-zA-Z0-9-@:%._\\+~#?&//=]{2,256}\\.[a-z]{2,63}\\b([-a-zA-Z0-9@:%._\\+~#?&//=]*)"
                },
                "pathRewrite": {
                  "$id": "#root/proxy/endpoints//harness/prod/pathRewrite",
                  "title": "PathRewrite",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "allowedHeaders": {
                  "$id": "#root/proxy/endpoints//harness/prod/allowedHeaders",
                  "title": "AllowedHeaders",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
