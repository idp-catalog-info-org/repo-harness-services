{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/gitlab-config-schema.json",
  "title": "GitLab Plugin Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gitlab": {
      "$id": "#root/gitlab",
      "title": "GitLab Configuration",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCodeOwnersPath": {
          "$id": "#root/gitlab/defaultCodeOwnersPath",
          "title": "Default Code Owners Path",
          "type": "string",
          "default": ".gitlab/CODEOWNERS",
          "description": "Default path for CODEOWNERS file."
        },
        "defaultReadmePath": {
          "$id": "#root/gitlab/defaultReadmePath",
          "title": "Default Readme Path",
          "type": "string",
          "default": ".gitlab/README.md",
          "description": "Default path for README file."
        },
        "allowedKinds": {
          "$id": "#root/gitlab/allowedKinds",
          "title": "Allowed Kinds",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["component"],
          "description": "Entity kinds to which the plugin applies."
        },
        "proxySecure": {
          "$id": "#root/gitlab/proxySecure",
          "title": "Proxy Secure",
          "type": "boolean",
          "default": true,
          "description": "Controls SSL certificate verification."
        },
        "cache": {
          "$id": "#root/gitlab/cache",
          "title": "Cache Settings",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$id": "#root/gitlab/cache/enabled",
              "title": "Enable Cache",
              "type": "boolean",
              "default": false,
              "description": "Enable caching for the GitLab plugin."
            },
            "ttl": {
              "$id": "#root/gitlab/cache/ttl",
              "title": "Cache TTL",
              "type": "integer",
              "default": 300,
              "description": "Cache time-to-live (TTL) for the GitLab plugin in seconds."
            }
          }
        }
      }
    }
  }
}
