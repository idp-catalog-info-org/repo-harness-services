  {
    "id": "6877e509bf22935e59217314",
    "accountIdentifier": "__GLOBAL_ACCOUNT_ID__",
    "identifier": "hql_traceable_risk_score",
    "dataSourceIdentifier": "traceable",
    "type": "HQL",
    "hqlTemplate": "with filtered_matches as ( find view idp:traceable_api_matches | filter idp_api_identifier = <+catalog.identifier> and parent_unique_id = <+catalog.parentUniqueId> | select { count() as match_count, avg(risk_score) as risk_score } ) find filtered_matches | select { case when match_count > 0 then risk_score else 'NO_MATCHING_ROWS' end as value }"
  },
  {
    "id": "6a5a09ea82fc8d4071d6c81b",
    "accountIdentifier": "__GLOBAL_ACCOUNT_ID__",
    "identifier": "hql_traceable_tot_issues",
    "dataSourceIdentifier": "traceable",
    "type": "HQL",
    "hqlTemplate": "with issue_summary as ( find view idp:traceable_api_matches m | inner join entity traceable:issues i on m.traceable_api_id = i.affected_entity_id | filter m.idp_api_identifier = <+catalog.identifier> and m.parent_unique_id = <+catalog.parentUniqueId> and i.status in ['VULNERABILITY_STATUS_OPEN', 'VULNERABILITY_STATUS_REOPENED'] | select { count() as issue_count } ) find issue_summary | select { case when issue_count > 0 then issue_count else 'NO_MATCHING_ROWS' end as value }"
  },
  {
    "id": "6a5a098582fc8d4071d6c819",
    "accountIdentifier": "__GLOBAL_ACCOUNT_ID__",
    "identifier": "hql_traceable_max_issues",
    "dataSourceIdentifier": "traceable",
    "type": "HQL",
    "hqlTemplate": "with issue_counts as ( find view idp:traceable_api_matches m | inner join entity traceable:issues i on m.traceable_api_id = i.affected_entity_id | filter m.idp_api_identifier = <+catalog.identifier> and m.parent_unique_id = <+catalog.parentUniqueId> and i.status in ['VULNERABILITY_STATUS_OPEN', 'VULNERABILITY_STATUS_REOPENED'] | select { m.traceable_api_id, count() as issue_count } | group_by m.traceable_api_id ), issue_summary as ( find issue_counts | aggregate { count() as match_count, max(issue_count) as issue_count } ) find issue_summary | select { case when match_count > 0 then issue_count else 'NO_MATCHING_ROWS' end as value }"
  },
  {
    "id": "6a5a098582fc8d4071d6c81a",
    "accountIdentifier": "__GLOBAL_ACCOUNT_ID__",
    "identifier": "hql_traceable_min_issues",
    "dataSourceIdentifier": "traceable",
    "type": "HQL",
    "hqlTemplate": "with issue_counts as ( find view idp:traceable_api_matches m | inner join entity traceable:issues i on m.traceable_api_id = i.affected_entity_id | filter m.idp_api_identifier = <+catalog.identifier> and m.parent_unique_id = <+catalog.parentUniqueId> and i.status in ['VULNERABILITY_STATUS_OPEN', 'VULNERABILITY_STATUS_REOPENED'] | select { m.traceable_api_id, count() as issue_count } | group_by m.traceable_api_id ), issue_summary as ( find issue_counts | aggregate { count() as match_count, min(issue_count) as issue_count } ) find issue_summary | select { case when match_count > 0 then issue_count else 'NO_MATCHING_ROWS' end as value }"
  },
  {
    "id": "6a5a098582fc8d4071d6c81c",
    "accountIdentifier": "__GLOBAL_ACCOUNT_ID__",
    "identifier": "hql_traceable_owasp_endpoint_count",
    "dataSourceIdentifier": "traceable",
    "type": "HQL",
    "hqlTemplate": "with matching_issue_endpoints as ( find entity traceable:issues | unnest owasp_values as owasp_value | filter status in ['VULNERABILITY_STATUS_OPEN', 'VULNERABILITY_STATUS_REOPENED'] and owasp_value in <+inputs.owasp> | select { affected_entity_id } ), issue_summary as ( find view idp:traceable_api_matches m | left join matching_issue_endpoints i on m.traceable_api_id = i.affected_entity_id | filter m.idp_api_identifier = <+catalog.identifier> and m.parent_unique_id = <+catalog.parentUniqueId> | select { count() as mapping_count, distinct_count(i.affected_entity_id) as endpoint_count } ) find issue_summary | select { case when mapping_count > 0 then endpoint_count else 'NO_MATCHING_ROWS' end as value }"
  },
