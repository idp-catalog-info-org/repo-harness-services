{
  "identifier": "harness.secret.create",
  "name": "Create Secret",
  "description": "Create a Harness secret at the requested scope.",
  "version": "1.0.0",
  "handler": "harness.secret.create",
  "category": "harness",
  "inputSchema": {
    "type": "object",
    "required": ["secretIdentifier", "secretValue"],
    "properties": {
      "secretIdentifier": { "type": "string" },
      "secretValue":      { "type": "string" },
      "scope":            { "type": "string", "enum": ["account", "org", "project"] }
    }
  }
}
