load("//:tools/bazel/harness.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["**/*.java"]),
    resources = [],
    visibility = ["//idp-service:__subpackages__"],
    deps = [
        "//:lombok",
        "//970-grpc/src/main/java/io/harness/grpc/client:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/entities:module",
        "//kafka-client/src/main/java/io/harness/kafka:module",
        "//kafka-client/src/main/java/io/harness/kafka/producers:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_inject_guice",
        "@maven//:com_google_protobuf_protobuf_java_util",
        "@maven//:io_confluent_kafka_protobuf_serializer",
        "@maven//:io_harness_platform_config_service_config_service_api",
        "@maven//:io_harness_platform_data_contracts_config_models",
        "@maven//:io_harness_platform_data_contracts_event_models",
        "@maven//:io_harness_platform_data_contracts_shared_models",
        "@maven//:io_harness_platform_schema_service_schema_service_api",
        "@maven//:io_harness_platform_type_registry_type_registry_model",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_yaml_snakeyaml",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
