load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//idp-service:__subpackages__"],
    deps = [
        "//:lombok",
        "//idp-service/src/main/java/io/harness/idp/aggregation/rules/entity:module",
        "//idp-service/src/main/java/io/harness/idp/aggregation/rules/repositories:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/events:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/helpers:module",
        "//idp-service/src/main/java/io/harness/idp/catalog/service:module",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
