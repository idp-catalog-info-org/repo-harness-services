load("@rules_java//java:defs.bzl", "java_binary")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

HarnessTeam = "PL"

java_library(
    name = "module",
    visibility = ["//120-ng-manager:__subpackages__"],
    exports = [
        "//120-ng-manager/modules/ng-subscriptions/contracts/src/main/java/io/harness/ngsubscriptions/entity:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/resource:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service/impl:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service/jobs:module",
    ],
)

java_library(
    name = "tests",
    testonly = True,
    visibility = ["//visibility:public"],
    exports = [
        "//120-ng-manager/modules/ng-subscriptions/src/test/java/io/harness/ngsubscriptions/service/impl:tests",
        "//120-ng-manager/modules/ng-subscriptions/src/test/java/io/harness/ngsubscriptions/service/jobs:tests",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    pmd_srcs = glob(["**/*.java"]),
)

run_tests()
