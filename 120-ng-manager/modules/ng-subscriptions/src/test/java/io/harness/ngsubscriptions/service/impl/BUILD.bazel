load("@rules_java//java:defs.bzl", "java_binary")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

HarnessTeam = "PL"

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//120-ng-manager/modules/ng-subscriptions/contracts/src/main/java/io/harness/ngsubscriptions/entity:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service/impl:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service/jobs:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/repositories/ngsubscriptions/custom:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/repositories/ngsubscriptions/spring:module",
        "//120-ng-manager/src/main/java/io/harness/repositories/ng/serviceaccounts:module",
        "//123-ng-core-user/src/main/java/io/harness/repositories/user/spring:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//license-manager/src/main/java/io/harness/moduleaccess:module",
        "@maven//:org_mockito_mockito_core",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_for_tests(
    checkstyle_srcs = glob(["**/*"]),
)

run_tests("*Test.java")
