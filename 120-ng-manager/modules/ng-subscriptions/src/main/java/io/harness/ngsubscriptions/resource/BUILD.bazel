load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/contracts/openapi/v1:ng-manager-server-spec-module",
        "//120-ng-manager/modules/ng-subscriptions/contracts/src/main/java/io/harness/ngsubscriptions/entity:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/ngsubscriptions/service:module",
        "//120-ng-manager/modules/ng-subscriptions/src/main/java/io/harness/repositories/ngsubscriptions/spring:module",
        "//930-ng-license-manager/src/main/java/io/harness/licensing/services:module",
        "//970-ng-commons/src/main/java/io/harness/constants:module",
        "//970-ng-commons/src/main/java/io/harness/utils:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_validation_validation_api",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
        "@maven//:org_springframework_data_spring_data_commons",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
