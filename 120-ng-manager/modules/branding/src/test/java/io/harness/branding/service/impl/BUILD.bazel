        "//120-ng-manager/modules/branding/src/main/java/io/harness/branding/outbox/branding/handler:module",
        "//120-ng-manager/modules/branding/src/main/java/io/harness/branding/outbox/brandingasset/events:module",
        "//120-ng-manager/modules/branding/src/main/java/io/harness/branding/outbox/brandingasset/handler:module",
        "//120-ng-manager/modules/branding/src/main/java/io/harness/branding/remote/v1/api:module",
        "//120-ng-manager/modules/branding/src/main/java/io/harness/branding/service:module",
        "//120-ng-manager/modules/branding/src/main/java/io/harness/branding/service/impl:module",
