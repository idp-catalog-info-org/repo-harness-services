load("@rules_java//java:defs.bzl", "java_binary")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis")

HarnessTeam = "PL"

java_library(
    name = "module",
    visibility = ["//120-ng-manager:__subpackages__"],
    exports = [
        "//120-ng-manager/modules/ip-allowlist/contracts/src/main/java/io/harness/ipallowlist/dto:module",
        "//120-ng-manager/modules/ip-allowlist/contracts/src/main/java/io/harness/ipallowlist/entity:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/ipallowlist:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/ipallowlist/events:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/ipallowlist/resource:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/ipallowlist/service:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/ipallowlist/service/impl:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/repositories/ipallowlist/custom:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/repositories/ipallowlist/spring:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/serializer:module",
        "//120-ng-manager/modules/ip-allowlist/src/main/java/io/harness/serializer/morphia:module",
    ],
)

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        ":module",
        "//990-commons-test:module",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis(
    pmd_srcs = glob(["**/*.java"]),
)

run_tests()
