load("@rules_java//java:defs.bzl", "java_binary")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis")

java_library(
    name = "module",
    resources = [],
    visibility = ["//120-ng-manager:__subpackages__"],
    exports = [
        "//120-ng-manager/modules/ldap/contracts/src/main/java/io/harness/ldap/resource:module",
        "//120-ng-manager/modules/ldap/contracts/src/main/java/io/harness/ldap/serializer:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/dto:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/entity:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/handler:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/mapper:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/remote/v1/api:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/resource:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/scheduler:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/service:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/service/impl:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/service/impl/errors:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/repositories:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/serializer:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/sso/entity:module",
    ],
)

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        ":module",
        "//990-commons-test:module",
    ],
)

run_tests()

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis(
    pmd_srcs = glob(["**/*.java"]),
)
