load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/contracts/openapi/v1:ng-manager-server-spec-module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/entity:module",
        "//400-rest-commons/src/main/java/software/wings/beans/sso:module",
        "//930-delegate-tasks/src/main/java/software/wings/beans/sso:module",
        "//970-ng-commons/src/main/java/io/harness/encryption:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:org_springframework_spring_beans",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
