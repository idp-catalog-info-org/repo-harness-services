load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/modules/ldap/contracts/src/main/java/io/harness/ldap/serializer:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/dto:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/ldap/entity:module",
        "//120-ng-manager/modules/ldap/src/main/java/io/harness/sso/entity:module",
        "//955-filters-sdk/src/main/java/io/harness/filter/serializer:module",
        "//960-persistence/src/main/java/io/harness/serializer:module",
        "//970-ng-commons/src/main/java/io/serializer/registrars:module",
        "//980-commons/src/main/java/io/harness/morphia:module",
        "//980-commons/src/main/java/io/harness/serializer/common:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_guava_guava",
        "@maven_redisson//:com_esotericsoftware_kryo",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
