        "//120-ng-manager/modules/ng-variables/contracts/src/main/java/io/harness/ng/core/variable:module",
        "//120-ng-manager/modules/ng-variables/contracts/src/main/java/io/harness/ng/core/variable/dto:module",
        "//120-ng-manager/modules/ng-variables/src/main/java/io/harness/ng/core/variable/expressions/functors:module",
        "//120-ng-manager/modules/ng-variables/src/main/java/io/harness/ng/core/variable/services:module",
        "//884-pms-commons/src/main/java/io/harness/pms/execution/utils:module",
        "//950-ng-project-n-orgs/src/main/java/io/harness/ng/core/services:module",
        "//970-ng-commons/src/main/java/io/harness/beans/scope:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
        "@maven//:junit_junit",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_powermock_powermock_api_mockito2",
        "@maven//:org_powermock_powermock_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
