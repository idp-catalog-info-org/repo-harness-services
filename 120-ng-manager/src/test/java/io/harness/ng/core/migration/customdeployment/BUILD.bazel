        "//127-cd-nextgen-entities/src/main/java/io/harness/cdng/customdeployment/helper:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/infrastructure/entity:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/service/entity:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/repositories/infrastructure/spring:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/repositories/service/spring:module",
        "//136-git-sync-manager/src/main/java/io/harness/gitsync/common/dtos:module",
        "//136-git-sync-manager/src/main/java/io/harness/gitsync/common/service:module",
        "//950-ng-project-n-orgs/src/main/java/io/harness/ng/core/services:module",
