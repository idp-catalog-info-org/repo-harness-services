        "//120-ng-manager/src/main/java/io/harness/ng/core/licenseusage/utils:module",
        "//930-ng-license-manager/src/main/java/io/harness/credit/entities:module",
        "//930-ng-license-manager/src/main/java/io/harness/credit/services:module",
        "//950-ng-core/src/main/java/io/harness/ng/core/licenseusage/entities:module",
        "//960-ng-license-beans/src/main/java/io/harness/credit/beans/credits:module",
        "//960-ng-license-beans/src/main/java/io/harness/credit/utils:module",
        "//960-persistence/src/main/java/io/harness/timescaledb:module",
        "//970-ng-commons/src/main/java/io/harness:module",
        "//970-ng-commons/src/main/java/io/harness/entities:module",
        "//990-commons-test/src/main/java/io/harness:module",
