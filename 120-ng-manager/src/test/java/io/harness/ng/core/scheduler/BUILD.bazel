load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//120-ng-manager/src/main/java/io/harness/ng/config:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/mapper:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/scheduler:module",
        "//120-ng-manager/src/main/java/io/harness/repositories/ng/core/spring:module",
        "//120-ng-manager/src/test/java/io/harness/base:tests",
        "//950-ng-project-n-orgs/src/main/java/io/harness/ng/core/events:module",
        "//960-persistence/src/main/java/io/harness/lock/interfaces:module",
        "//980-commons/src/main/java/io/harness/authorization:module",
        "//980-commons/src/main/java/io/harness/ng/core/common/beans:module",
        "//980-commons/src/main/java/io/harness/security:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
