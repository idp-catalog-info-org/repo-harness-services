    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//120-ng-manager/src/main/java/io/harness/ng/webhook:module",
        "//120-ng-manager/src/main/java/io/harness/ng/webhook/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/webhook/resources:module",
        "//120-ng-manager/src/main/java/io/harness/ng/webhook/services/api:module",
        "//950-ng-core/src/main/java/io/harness/ng/webhook:module",
        "//950-ng-core/src/main/java/io/harness/ng/webhook/services/api:module",
        "//952-scm-java-client/src/main/java/io/harness/constants:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/dto:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_glassfish_jersey_core_jersey_server",
        "@maven//:org_mockito_mockito_core",
    ],
