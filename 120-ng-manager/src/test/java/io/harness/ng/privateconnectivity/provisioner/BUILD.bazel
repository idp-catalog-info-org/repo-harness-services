load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/provisioner:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/sanitizer:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/util:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/vendorclient:module",
        "//120-ng-manager/src/main/java/io/harness/repositories/ng/privateconnectivity:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/privateconnectivity:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//oidc-core/src/main/java/io/harness/oidc/config:module",
        "//oidc-core/src/main/java/io/harness/oidc/jwks:module",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
