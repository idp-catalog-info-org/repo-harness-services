load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/core/migration:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/migration/background:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/migration/timescale:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/accesscontrol:module",
        "//440-connector-nextgen/src/main/java/io/harness/connector/migration:module",
        "//958-migration-sdk/src/main/java/io/harness/migration/beans:module",
        "//958-migration-sdk/src/main/java/io/harness/migration/entities:module",
        "//958-migration-sdk/src/main/java/io/harness/migration/ng:module",
        "//958-migration-sdk/src/main/java/io/harness/migration/utils:module",
        "//960-persistence/src/main/java/io/harness/ng:module",
        "//980-commons/src/main/java/io/harness/annotations:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/access-control/admin-client/src/main/java/io/harness/accesscontrol/migration:module",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_hibernate_validator_hibernate_validator",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
