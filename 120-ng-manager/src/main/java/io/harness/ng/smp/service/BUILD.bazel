load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/config:module",
        "//120-ng-manager/src/main/java/io/harness/ng/smp/dto:module",
        "//120-ng-manager/src/main/java/io/harness/ng/smp/entities:module",
        "//120-ng-manager/src/main/java/io/harness/repositories/ng/smp:module",
        "//930-ng-core-clients/src/main/java/io/harness/zendesk/remote:module",
        "//960-persistence/src/main/java/io/harness/annotation:module",
        "//970-ng-commons/src/main/java/io/harness/rsa:module",
        "//980-commons/src/main/java/io/harness/security:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_auth0_java_jwt",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_google_inject_guice",
        "@maven//:com_intellij_annotations",
        "@maven//:com_nimbusds_nimbus_jose_jwt",
        "@maven//:io_swagger_core_v3_swagger_annotations",
        "@maven//:org_apache_commons_commons_lang3",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
