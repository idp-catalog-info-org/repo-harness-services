load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/config:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/services:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/util:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/vendorclient:module",
        "//120-ng-manager/src/main/java/io/harness/repositories/ng/privateconnectivity:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/privateconnectivity:module",
        "//980-commons/src/main/java/io/harness/manage:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_dropwizard_core",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_springframework_data_spring_data_commons",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
