load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/services:module",
        "//890-sm-core/src/main/java/io/harness/ng/core/api:module",
        "//950-delegate-tasks-beans/src/main/java/io/harness/ng/core:module",
        "//950-delegate-tasks-beans/src/main/java/io/harness/secretmanagerclient:module",
        "//960-ng-core-beans/src/main/java/io/harness/beans:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/privateconnectivity:module",
        "//960-persistence/src/main/java/io/harness/lock/interfaces:module",
        "//970-ng-commons/src/main/java/io/harness:module",
        "//970-ng-commons/src/main/java/io/harness/metrics/service/api:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_inject_guice",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
