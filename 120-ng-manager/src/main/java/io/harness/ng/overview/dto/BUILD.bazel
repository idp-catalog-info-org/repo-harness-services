load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//126-instance/src/main/java/io/harness/entities:module",
        "//126-instance/src/main/java/io/harness/models:module",
        "//126-instance/src/main/java/io/harness/models/dashboard:module",
        "//930-ng-core-clients/src/main/java/io/harness/gitops:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/dashboard:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/environment/beans:module",
        "//970-ng-commons/src/main/java/io/harness/gitsync/beans:module",
        "//970-ng-commons/src/main/java/io/harness/gitsync/sdk:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:io_swagger_core_v3_swagger_annotations",
        "@maven//:javax_validation_validation_api",
        "@maven//:org_apache_commons_commons_lang3",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
