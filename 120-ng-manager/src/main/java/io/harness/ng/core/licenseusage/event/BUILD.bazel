load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/core/licenseusage/mapper:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/licenseusage/utils:module",
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//950-ng-core/src/main/java/io/harness/ng/core/licenseusage/services:module",
        "//953-events-api/src/main/java/io/harness/eventsframework:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/impl/redis:module",
        "//953-events-api/src/main/java/io/harness/ng/core/event:module",
        "//953-events-api/src/main/proto:953_events_api_java_proto",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/licenseusage/dto:module",
        "@maven//:com_google_inject_guice",
        "@maven//:com_google_protobuf_protobuf_java",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
