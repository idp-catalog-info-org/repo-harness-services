load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/contracts/openapi/v1:ng-manager-server-spec-module",
        "//120-ng-manager/src/main/java/io/harness/ng/config:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/sfexecution/entity:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/sfexecution/mappers:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/sfexecution/services:module",
        "//970-ng-commons/src/main/java/io/harness/beans/scope:module",
        "//970-ng-commons/src/main/java/io/harness/remote/client:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/pipeline-service/pms-client/src/main/java/io/harness/pipeline/remote:module",
        "//pipeline-service/modules/pms-contracts/src/main/java/io/harness/pms/execution:module",
        "@maven//:com_google_inject_guice",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
