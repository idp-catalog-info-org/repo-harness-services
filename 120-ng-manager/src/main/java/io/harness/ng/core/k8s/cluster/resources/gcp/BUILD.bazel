load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//125-cd-nextgen/src/main/java/io/harness/cdng/k8s/resources/gcp:module",
        "//125-cd-nextgen/src/main/java/io/harness/cdng/k8s/resources/gcp/service:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/cdng/infra/definition/config:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/cdng/infra/mapper:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/infrastructure/entity:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/infrastructure/services:module",
        "//970-ng-commons/src/main/java/io/harness/beans:module",
        "//970-ng-commons/src/main/java/io/harness/constants:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/dto:module",
        "//970-ng-commons/src/main/java/io/harness/utils/identifierref:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_metrics_metrics_annotation",
        "@maven//:io_swagger_core_v3_swagger_annotations",
        "@maven//:io_swagger_swagger_annotations",
        "@maven//:javax_validation_validation_api",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
