load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/contracts/openapi/v1:ng-manager-server-spec-module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/licenseusage/dto:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/licenseusage/utils:module",
        "//950-ng-core/src/main/java/io/harness/ng/core/licenseusage/entities:module",
        "//960-persistence/src/main/java/io/harness/timescaledb:module",
        "//970-ng-commons/src/main/java/io/harness/entities:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_validation_validation_api",
        "@maven//:joda_time_joda_time",
        "@maven//:net_sf_opencsv_opencsv",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_data_spring_data_commons",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
