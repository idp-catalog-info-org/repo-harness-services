load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/contracts/openapi/v1:ng-manager-server-spec-module",
        "//126-instance/src/main/java/io/harness/dtos:module",
        "//126-instance/src/main/java/io/harness/entities:module",
        "//126-instance/src/main/java/io/harness/repositories/releasedetailsmapping:module",
        "//126-instance/src/main/java/io/harness/service/instance:module",
        "//878-ng-common-utilities/src/main/java/io/harness/pms/rbac:module",
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//970-ng-commons/src/main/java/io/harness/security/annotations:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//access-control/contracts/api/src/main/java/io/harness/accesscontrol/acl/api:module",
        "//clients/access-control/sdk/src/main/java/io/harness/accesscontrol:module",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_dropwizard_jersey",
        "@maven//:javax_validation_validation_api",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
