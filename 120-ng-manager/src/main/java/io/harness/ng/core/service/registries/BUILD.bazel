load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/core/service/inputsmapper:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/cdng/manifest:module",
        "//127-cd-nextgen-entities/src/main/java/io/harness/cdng/manifest/yaml/storeConfig:module",
        "//950-delegate-tasks-beans/src/main/java/io/harness/delegate/task/artifacts/source:module",
        "//960-ng-core-beans/src/main/java/io/harness/cdng/service/beans:module",
        "//960-ng-core-beans/src/main/java/io/harness/unified/cd/service/artifacts:module",
        "//960-ng-core-beans/src/main/java/io/harness/unified/cd/service/manifests:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
