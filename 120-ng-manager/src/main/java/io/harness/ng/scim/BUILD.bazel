load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

filegroup(
    name = "java_srcs",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
)

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    resources = [
        "//120-ng-manager/src/main/resources:scim-schemas",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/api:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/invites/api:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/invites/entities:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/user:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/user/entities:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/user/service:module",
        "//123-ng-core-user/src/main/java/io/harness/ng/core/utils:module",
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//947-scim-core/src/main/io/harness/scim:module",
        "//947-scim-core/src/main/io/harness/scim/service:module",
        "//955-account-mgmt/src/main/java/io/harness/account/services:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/dto:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/invites:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/user:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/user/remote/dto:module",
        "//970-ng-commons/src/main/java/io/harness:module",
        "//970-ng-commons/src/main/java/io/harness/beans/scope:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/common/beans:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//980-commons/src/main/java/io/harness/serializer:module",
        "//980-commons/src/main/java/io/harness/utils:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_javaee_api",
        "@maven//:javax_validation_validation_api",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
