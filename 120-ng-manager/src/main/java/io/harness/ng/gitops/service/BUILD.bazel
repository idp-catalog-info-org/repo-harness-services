        "//127-cd-nextgen-entities/src/main/java/io/harness/ng/core/service/services:module",
        "//930-ng-core-clients/src/main/java/io/harness/gitops/models:module",
        "//940-secret-manager-client/src/main/java/io/harness/secretmanagerclient/services/api:module",
        "//951-delegate-task-commons/src/main/java/io/harness/delegate/beans:module",
        "//970-api-services-beans/src/main/java/io/harness/security/encryption:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
