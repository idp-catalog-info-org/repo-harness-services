load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//120-ng-manager/src/main/java/io/harness/ng/accesscontrol/mockserver:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/entities/metrics:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/entities/migration:module",
        "//120-ng-manager/src/main/java/io/harness/ng/core/migration:module",
        "//120-ng-manager/src/main/java/io/harness/ng/feedback/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/privateconnectivity/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/serviceaccounts/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/tunnel/entities:module",
        "//120-ng-manager/src/main/java/io/harness/ng/webhook/entities:module",
        "//490-ce-commons/src/main/java/io/harness/ccm/costSettings:module",
        "//980-commons/src/main/java/io/harness/morphia:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
