load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//120-ng-manager/src/main/java/io/harness/ng/gitops/config:module",
        "//878-ng-common-utilities/src/main/java/io/harness/pms/plan/execution:module",
        "//884-pms-commons/src/main/java/io/harness/pms/pipeline:module",
        "//953-events-api/src/main/java/io/harness/eventsframework:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/api:module",
        "//958-debezium-utils/src/main/java/io/harness/debezium/eventHandler:module",
        "//958-debezium-utils/src/main/java/io/harness/debezium/redisconsumer:module",
        "//959-psql-database-models:module",
        "//960-persistence/src/main/java/io/harness/queue:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_cache_cache_api",
        "@maven//:org_jooq_jooq",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
