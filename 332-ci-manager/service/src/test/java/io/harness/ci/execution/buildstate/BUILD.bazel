        "//950-delegate-tasks-beans/src/main/java/io/harness/delegate/beans/ci:module",
        "//950-delegate-tasks-beans/src/main/java/io/harness/delegate/beans/ci/k8s:module",
        "//950-delegate-tasks-beans/src/main/java/io/harness/delegate/beans/ci/vm:module",
        "//950-delegate-tasks-beans/src/main/java/io/harness/delegate/beans/ci/vm/dlite:module",
