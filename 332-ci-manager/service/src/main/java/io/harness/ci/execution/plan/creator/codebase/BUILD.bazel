load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//332-ci-manager/service/src/main/java/io/harness/ci/execution/states/codebase:module",
        "//877-pipeline-ci-cd-commons/src/java/io/harness/ci/execution/integrationstage:module",
        "//877-pipeline-ci-cd-commons/src/java/io/harness/ci/states/codebase:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/execution:module",
        "//884-pms-commons/src/main/java/io/harness/pms/execution:module",
        "//884-pms-commons/src/main/java/io/harness/pms/sdk/core/adviser:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//953-yaml-commons/src/main/java/io/harness/yaml/extended/ci/codebase:module",
        "//980-commons/src/main/java/io/harness/serializer:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/pipeline-service/pms-sdk-core:module",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:com_intellij_annotations",
