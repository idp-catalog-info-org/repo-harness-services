load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//332-ci-manager/service/src/main/java/io/harness/ci/execution/execution:module",
        "//332-ci-manager/service/src/main/java/io/harness/ci/execution/execution/metadata:module",
        "//332-ci-manager/service/src/main/java/io/harness/ci/repositories:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/yaml/extended/infrastrucutre:module",
        "//942-enforcement-sdk/src/main/java/io/harness/enforcement/client/custom:module",
        "//942-enforcement-sdk/src/main/java/io/harness/enforcement/client/usage:module",
        "//943-enforcement-beans/src/main/java/io/harness/enforcement/beans:module",
        "//943-enforcement-beans/src/main/java/io/harness/enforcement/beans/metadata:module",
        "//960-ng-license-beans/src/main/java/io/harness/licensing:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
