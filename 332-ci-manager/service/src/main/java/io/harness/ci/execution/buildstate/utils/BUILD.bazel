load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//332-ci-manager/contracts/src/main/java/io/harness/cimanager/dependencies:module",
        "//332-ci-manager/service/src/main/java/io/harness/ci/execution:module",
        "//877-pipeline-ci-cd-commons/src/java/io/harness/beans/stages:module",
        "//877-pipeline-ci-cd-commons/src/java/io/harness/ci/execution/utils/ci:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/serializer:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/yaml/extended/infrastrucutre:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/ci/commonconstants:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
        "@maven//:org_apache_commons_commons_lang3",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
