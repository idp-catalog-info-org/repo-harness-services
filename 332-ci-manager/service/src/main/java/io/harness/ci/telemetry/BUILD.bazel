    deps = [
        "//:lombok",
        "//323-sto-utilities/src/main/java/io/harness/stoserviceclient:module",
        "//332-ci-manager/service/src/main/java/io/harness/ci/dashboard:module",
        "//332-ci-manager/service/src/main/java/io/harness/ci/execution/license:module",
        "//332-ci-manager/service/src/main/java/io/harness/ci/repositories:module",
        "//930-ng-license-manager/src/main/java/io/harness/repositories:module",
        "//955-account-mgmt/src/main/java/io/harness/account/utils:module",
        "//970-telemetry-beans/src/main/java/io/harness/telemetry:module",
        "//980-commons/src/main/java/io/harness/configuration:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "@maven//:com_google_inject_guice",
