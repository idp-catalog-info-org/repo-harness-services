load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//332-ci-manager/contracts/src/main/java/io/harness/cimanager/executionconfig/api:module",
        "//877-pipeline-ci-cd-commons/src/java/io/harness/cd/beans/moduleinfo:module",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/stages/stage:module",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/steps:module",
        "//960-yaml-sdk/src/main/java/io/harness/yaml/schema/beans:module",
        "//970-ng-commons/src/main/java/io/harness/constants:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/dto:module",
        "//979-recaster/src/main/java/io/harness/annotation:module",
        "//980-commons/src/main/java/io/harness/encryption:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/pipeline-service/pms-sdk-core:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:io_swagger_core_v3_swagger_annotations",
        "@maven//:io_swagger_swagger_annotations",
        "@maven//:javax_validation_validation_api",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
