        "//953-yaml-commons/src/main/java/io/harness/plancreator/execution:module",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/stages/stage:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//960-yaml-sdk/src/main/java/io/harness/yaml/schema:module",
