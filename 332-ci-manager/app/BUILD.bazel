    "//:lombok",
]

java_binary(
    name = "module",
    data = ["//:resource"],
    main_class = "io.harness.app.CIManagerApplication",
    resources = [
        "//332-ci-manager/app/src/resources:resource",
    ],
    visibility = [
        "//315-sto-manager:__subpackages__",
    ],
    runtime_deps = [
        "//332-ci-manager/app/src/main/java/io/harness/ci:module",
        "//332-ci-manager/app/src/main/java/io/harness/ci/api:module",
        "//332-ci-manager/app/src/main/java/io/harness/ci/metrics:module",
        "//332-ci-manager/app/src/main/java/io/harness/ci/migration:module",
        "//332-ci-manager/app/src/resources",
    ],
)

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["src/test/**/*.java"]),
    resources = [
        "//332-ci-manager/app/src/test/resources:resource",
    ],
    visibility = ["//visibility:public"],
    deps = shared_dependencies + [
        "module",
        "//332-ci-manager/app/src/main/java/io/harness/ci:module",
        "//332-ci-manager/app/src/main/java/io/harness/ci/api:module",
        "//332-ci-manager/app/src/main/java/io/harness/ci/migration:module",
        "//960-persistence:supporter-test",
        "//970-ng-commons:module",
        "//980-commons/src/main/java/io/harness/proc:module",
        "//990-commons-test:module",
        "//kafka-client/src/main/java/io/harness/kafka:module",
        "//kafka-client/src/main/java/io/harness/kafka/producers:module",
        "@maven//:io_dropwizard_dropwizard_testing",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_inline",
        "@maven//:org_powermock_powermock_module_junit4",
        "@maven//:org_powermock_powermock_reflect",
    ],
)

run_tests()

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis(
    run_checkstyle = False,
    run_pmd = False,
)
