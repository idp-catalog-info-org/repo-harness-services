    "//332-ci-manager/service/src/main/java/io/harness/ci/execution/execution/artifactDetails:module",
    "//420-delegate-service/src/main/java/io/harness/serializer:module",
    "//884-pms-commons/src/main/java/io/harness/pms/rbac:module",
    "//900-git-sync-sdk/src/main/java/io/harness/gitsync:module",
    "//900-git-sync-sdk/src/main/java/io/harness/gitsync/events:module",
    "//900-git-sync-sdk/src/main/java/io/harness/gitsync/persistance/testing:module",
    "//930-ng-license-manager/src/main/java/io/harness/licensing/accesscontrol:module",
    "//940-primary-version-manager/src/main/java/io/harness/app:module",
    "//940-primary-version-manager/src/main/java/io/harness/controller:module",
    "//940-primary-version-manager/src/main/java/io/harness/resource:module",
    "//942-enforcement-sdk/src/main/java/io/harness/enforcement/client:module",
    "//942-enforcement-sdk/src/main/java/io/harness/enforcement/client/resources:module",
    "//950-telemetry/src/main/java/io/harness/telemetry:module",
    "//950-telemetry/src/main/java/io/harness/telemetry/segment:module",
    "//950-wait-engine/src/main/java/io/harness/waiter/nrcsp:module",
    "//955-account-mgmt/src/main/java/io/harness/account/accesscontrol:module",
