    "//955-outbox-sdk/src/main/java/io/harness/outbox/module:module",
    "//958-migration-sdk/src/main/java/io/harness/migration/ng:module",
    "//958-migration-sdk/src/main/java/io/harness/migration/timescale:module",
    "//960-yaml-sdk/src/main/java/io/harness/yaml:module",
    "//960-ng-core-beans/src/main/java/io/harness/ng/core/exceptionmappers:module",
    "//965-ng-filter/src/main/java/io/harness/security:module",
