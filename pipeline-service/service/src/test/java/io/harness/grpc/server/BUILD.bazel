load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//970-grpc/src/main/java/io/harness/grpc/client:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration:module",
        "//pipeline-service/service/src/main/java/io/harness/pipeline/service:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution/data/service/expressions:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution/data/service/outcome:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution/data/service/outputs:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/sdk:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/sdk/service/execution:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/template:module",
        "//pipeline-service/service/src/test/java/io/harness:tests",
        "@maven//:com_google_guava_guava",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_services",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
