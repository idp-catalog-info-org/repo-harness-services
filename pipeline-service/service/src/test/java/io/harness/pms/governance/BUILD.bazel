java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    resources = [
        "//pipeline-service/service/src/main/resources:resource",
        "//pipeline-service/service/src/main/resources:static_resource",
        "//pipeline-service/service/src/test/resources:resource",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/pms/sdk:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/governance:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/sdk:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_core",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_grpc_grpc_testing",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jooq_joor",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
