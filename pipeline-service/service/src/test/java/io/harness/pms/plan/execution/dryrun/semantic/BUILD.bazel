        "//970-ng-commons/src/main/java/io/harness/remote/client:module",
        "//970-ng-commons/src/main/proto:970_ng_java_contract_proto",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/contracts/openapi/v1:pipeline-server-spec-module",
        "//pipeline-service/modules/ng-triggers/contracts/src/main/java/io/harness/ngtriggers:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution/dryrun/semantic:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution/dryrun/semantic/rules:module",
