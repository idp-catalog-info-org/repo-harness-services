load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    resources = [
        "//pipeline-service/service/src/main/resources:static_resource",
        "//pipeline-service/service/src/test/resources:resource",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/node/service:module",
        "//pipeline-service/modules/pms-contracts/src/main/proto/io/harness/pms/contracts/stages:stage_contracts_java_proto",
        "//pipeline-service/service/src/main/java/io/harness/pms/event/gitNotification:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/notification/gitstatus:module",
        "//pipeline-service/service/src/main/java/io/harness/utils:module",
        "@maven//:junit_junit",
        "@maven//:org_jooq_joor",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
