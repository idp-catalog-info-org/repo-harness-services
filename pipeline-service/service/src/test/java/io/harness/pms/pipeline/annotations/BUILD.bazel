load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/annotations:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/contracts/src/main/java/io/harness/pms/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/repositories/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/utils:module",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
