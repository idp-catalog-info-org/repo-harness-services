load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/pms/events:module",
        "//884-pms-commons/src/main/java/io/harness/pms/events/base:module",
        "//959-ng-persistence/src/main/java/io/harness/mongo/helper:module",
        "//970-ng-commons/src/main/java/io/harness/metrics/service/api:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/ng-triggers/src/main/java/io/harness/ngtriggers/service:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/node/service:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/plan/service:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipelinedelete/beans/entity:module",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_cache_cache_api",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
