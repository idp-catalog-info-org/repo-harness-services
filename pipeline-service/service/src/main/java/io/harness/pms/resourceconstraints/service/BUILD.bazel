        "//884-pms-commons/src/main/java/io/harness/pms/utils:module",
        "//980-commons/src/main/java/io/harness/distribution/constraint:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//980-commons/src/main/java/io/harness/logging/autolog:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/contracts/src/main/java/io/harness/pms/resourceconstraints/response:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/resourcerestraint:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/resourcerestraint/beans:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/resourcerestraint/service:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/node/service:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/plan/service:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/service/intfc:module",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
