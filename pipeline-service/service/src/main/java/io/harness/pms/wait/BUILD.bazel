        "//clients/access-control/sdk/src/main/java/io/harness/accesscontrol:module",
        "//pipeline-service/contracts/src/main/java/io/harness/pms/wait:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/wait:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/wait:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/node/service:module",
