        "//:lombok",
        "//940-feature-flag/src/main/java/io/harness/ff:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/api:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//959-debezium-beans/src/main/proto:959_debezium_beans_java_proto",
        "//970-ng-commons/src/main/java/io/serializer/mapper:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//kafka-client/src/main/java/io/harness/kafka:module",
        "//kafka-client/src/main/java/io/harness/kafka/common:module",
        "//kafka-client/src/main/java/io/harness/kafka/config:module",
        "//kafka-client/src/main/java/io/harness/kafka/consumers:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/event/overviewLandingPage:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_confluent_kafka_avro_serializer",
        "@maven//:org_apache_avro_avro",
        "@maven//:org_apache_kafka_kafka_clients",
