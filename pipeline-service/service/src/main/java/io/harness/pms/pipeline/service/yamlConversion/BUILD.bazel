load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/go-convert/src/main/java/io/harness/goconvert:module",
        "//clients/go-convert/src/main/proto:go_convert_java_proto",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/yamlConversion:module",
        "//pipeline-service/service/src/main/java/io/harness/repositories/pipeline/yamlConversion:module",
        "@maven//:com_google_inject_guice",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
