load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//877-pipeline-ci-cd-commons/src/java/io/harness/beans/steps:module",
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//884-pms-commons/src/main/java/io/harness/pms/pipeline:module",
        "//884-pms-commons/src/main/java/io/harness/pms/plan/creation:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//970-ng-commons/src/main/java/io/harness/pms/yaml:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/pms/sdk:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/creation/info:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/sdk:module",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_validation_validation_api",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
    test_only = True,
)
