load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//953-yaml-commons/src/main/java/io/harness/yaml/schema/inputs/beans:module",
        "//960-yaml-sdk/src/main/java/io/harness/yaml/schema:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/dto:module",
        "//980-commons/src/main/java/io/harness/encryption:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/contracts/src/main/java/io/harness/pms/schema:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/plancreator/pipeline:module",
        "//pipeline-service/modules/pms-contracts/src/main/java/io/harness/pms/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/api:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/service:module",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_validation_validation_api",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
