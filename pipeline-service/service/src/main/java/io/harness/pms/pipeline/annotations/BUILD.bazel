load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/annotations:module",
        "//960-persistence/src/main/java/io/harness/objectstore:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/contracts/src/main/java/io/harness/pms/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/pipeline/service:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/annotations:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/instrumentaion:module",
        "//pipeline-service/service/src/main/java/io/harness/repositories/annotations:module",
        "@maven//:com_google_cloud_google_cloud_storage",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_annotation_javax_annotation_api",
        "@maven//:org_mongodb_mongo_java_driver",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
