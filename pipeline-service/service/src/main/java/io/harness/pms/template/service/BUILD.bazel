load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//900-git-sync-sdk/src/main/java/io/harness/gitsync/interceptor:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/template:module",
        "//960-ng-core-beans/src/main/java/io/harness/ng/core/template/refresh:module",
        "//970-api-services-beans/src/main/java/io/harness/git/model:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//980-commons/src/main/java/io/harness/gitcaching:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/template-service/src/main/java/io/harness/template/remote:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/service/enforcement:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/pipeline/service/intfc:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/template/utils:module",
        "@maven//:com_google_inject_guice",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
