load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//953-yaml-commons/src/main/java/io/harness/yaml/core:module",
        "//960-persistence/src/main/java/io/harness/elasticsearch/framework:module",
        "//960-persistence/src/main/java/io/harness/elasticsearch/utils:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/common/beans:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/pms-contracts/src/main/java/io/harness/pms/execution:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/search/entity/beans:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/search/utils:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/plan/execution/beans/dto:module",
        "@maven//:co_elastic_clients_elasticsearch_java",
        "@maven//:com_google_inject_guice",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
