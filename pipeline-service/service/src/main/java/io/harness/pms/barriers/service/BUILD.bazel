    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/pms/execution/utils:module",
        "//959-timeout-engine/src/main/java/io/harness/repositories:module",
        "//959-timeout-engine/src/main/java/io/harness/timeout:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/distribution/barrier:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/barriers/beans:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/barriers/beans:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/barriers/service:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/node/service:module",
        "//pipeline-service/service/src/main/java/io/harness/pms/barriers/beans:module",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
    ],
