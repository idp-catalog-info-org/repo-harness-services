load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

# Sources are compiled by the parent BUILD.bazel (:beans target)
filegroup(
    name = "srcs",
    srcs = glob(["*.java"]),
    visibility = ["//pipeline-service:__subpackages__"],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
