        "//980-commons/src/main/java/io/harness/exception:module",
        "//980-commons/src/main/java/io/harness/exception/exceptionmanager:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/interrupts:module",
        "//pipeline-service/service/src/main/java/io/harness/config:module",
        "//pipeline-service/service/src/main/java/io/harness/pipeline/service:module",
