load("@rules_java//java:defs.bzl", "java_binary")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis")

java_library(
    name = "module",
    visibility = [
        "//110-change-data-capture:__subpackages__",
        "//pipeline-service:__subpackages__",
    ],
    exports = [
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/data:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/execution/stage:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/execution/step:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/expression/field/dummy:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/interrupts:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/plan:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/pms/data/output:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/pms/execution/utils:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/pms/sdk:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/registrars:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/serializer:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/serializer/kryo:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/serializer/morphia:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/serializer/spring/converters/outputs:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/serializer/spring/converters/stepdetails:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/serializer/spring/converters/stepparameters:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/timeout/trackers/active:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/timeout/trackers/events:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/wait:module",
    ],
)

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["src/test/**/*.java"]),
    visibility = ["//pipeline-service:__subpackages__"],
    deps = [
        ":module",
        "//:lombok",
        "//960-persistence:supporter-test",
        "//990-commons-test:module",
        "@maven//:com_google_inject_guice",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jooq_joor",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_tests()

java_test(
    name = "OrchestrationBeansComponentTest",
    srcs = ["src/test/java/io/harness/OrchestrationBeansComponentTest.java"],
    tags = ["component_test"],
    test_class = "io.harness.OrchestrationBeansComponentTest",
    visibility = ["//visibility:public"],
    deps = [
        ":tests",
        "//:lombok",
        "//980-commons/src/main/java/io/harness/testing:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "@maven//:com_google_inject_guice",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
    ],
)

# run static analysis macro for pmd/checkstyle/sonarqube checks
run_analysis(
    run_pmd = False,
)
