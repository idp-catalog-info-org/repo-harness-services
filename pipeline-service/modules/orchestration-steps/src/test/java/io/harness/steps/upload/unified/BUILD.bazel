load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/steps/common:module",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/steps/unified:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//953-yaml-commons/src/main/java/io/harness/yaml/core/variables/v1:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/upload:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/upload/unified:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/upload/unified:module",
        "//pipeline-service/modules/orchestration/contracts/src/main/java/io/harness/steps:module",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
