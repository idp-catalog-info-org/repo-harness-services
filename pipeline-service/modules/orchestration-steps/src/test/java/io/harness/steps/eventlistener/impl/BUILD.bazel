load("//:tools/bazel/GenTestRules.bzl", "run_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//127-cd-nextgen-entities/src/main/java/io/harness/cdng/common/beans:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/repositories:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/eventlistener/impl:module",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_inline",
    ],
)

run_tests("**/*Test.java")
