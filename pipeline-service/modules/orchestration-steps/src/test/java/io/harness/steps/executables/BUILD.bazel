load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests")

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//878-ng-common-utilities/src/main/java/io/harness:module",
        "//878-ng-common-utilities/src/main/java/io/harness/telemetry/helpers:module",
        "//950-opa-client/src/main/java/io/harness/opaclient:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/sdk/core/steps/io/v1:module",
        "//980-commons/src/main/java/io/harness/tasks:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/executables:module",
        "//pipeline-service/modules/pms-contracts/src/main/proto:pms_contracts_java_proto",
        "@maven//:com_google_inject_guice",
        "@maven//:junit_junit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_for_tests(
    checkstyle_srcs = glob(["*"]),
)

run_tests("*Test.java")
