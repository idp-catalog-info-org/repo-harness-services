{
  "version": 1,
  "kind": "pipeline",
  "spec": {
    "stages": [
      {
        "id": "dynamicStage",
        "name": "dynamicStage",
        "dynamic": {
          "source-config": {
            "uses": "git",
            "with": {
              "connector": "account.git",
              "branch": "main",
              "commit": "commit-sha",
              "path": ".harness/pipeline.yaml",
              "repo": "repo"
            }
          }
        }
      }
    ]
  }
}
