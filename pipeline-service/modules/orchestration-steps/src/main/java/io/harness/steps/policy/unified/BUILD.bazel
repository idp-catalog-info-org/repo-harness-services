load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/GenTestRules.bzl", "run_tests")
load("//:tools/bazel/macros.bzl", "run_analysis_for_tests", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//879-pipeline-ci-commons/src/main/java/io/harness/ci/plan/creator/step/unified:module",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/steps/common:module",
        "//953-yaml-commons/src/main/java/io/harness/plancreator/steps/unified:module",
        "//953-yaml-commons/src/main/java/io/harness/pms/yaml:module",
        "//970-ng-commons/src/main/java/io/harness/pms/yaml:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/policy:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/policy/custom:module",
        "//pipeline-service/modules/orchestration/contracts/src/main/java/io/harness/steps:module",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_google_guava_guava",
    ],
)

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/policy/unified:module",
        "@maven//:junit_junit",
        "@maven//:org_mockito_mockito_core",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)

run_tests("*Test.java")
