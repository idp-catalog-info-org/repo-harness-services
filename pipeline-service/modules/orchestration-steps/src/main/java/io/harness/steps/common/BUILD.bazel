        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/resourcerestraint:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/approval/step/entities:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/eventlistener:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/resourcerestraint/service:module",
