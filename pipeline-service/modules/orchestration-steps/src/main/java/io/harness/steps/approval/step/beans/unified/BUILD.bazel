        "//970-ng-commons/src/main/java/io/harness/pms/yaml:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/approval/step/beans:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/approval/step/custom:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/approval/step/harness:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/approval/step/jira:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/approval/step/servicenow:module",
