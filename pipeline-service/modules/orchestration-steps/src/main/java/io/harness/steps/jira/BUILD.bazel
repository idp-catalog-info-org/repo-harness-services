        "//clients/pipeline-service/pms-sdk-core/src/main/java/io/harness/pms/sdk/core/variables/helper:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/jira/create:module",
        "//pipeline-service/modules/orchestration-steps/contracts/src/main/java/io/harness/steps/jira/update:module",
