        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/steps/stepinfo/V1:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/beans/yaml/extended/cd/core:module",
        "//879-pipeline-ci-commons/src/main/java/io/harness/steps/container/execution:module",
        "//960-continuous-features/src/generated/java/io/harness/cf/openapi:module",
        "//960-continuous-features/src/main/java/io/harness/cf:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/approval/step:module",
        "//pipeline-service/modules/orchestration-steps/src/main/java/io/harness/steps/approval/step/entities:module",
