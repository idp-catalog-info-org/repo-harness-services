load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/pms/plan/execution:module",
        "//952-scm-java-client/src/main/java/io/harness/beans:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//980-commons/src/main/java/io/harness/expression:module",
        "//980-commons/src/main/java/io/harness/expression/common:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/ng-triggers/contracts/src/main/java/io/harness/ngtriggers/beans/source/webhook:module",
        "//pipeline-service/modules/ng-triggers/src/main/java/io/harness/ngtriggers:module",
        "//pipeline-service/modules/ng-triggers/src/main/java/io/harness/ngtriggers/expressions/functors:module",
        "//pipeline-service/modules/ng-triggers/src/main/java/io/harness/ngtriggers/expressions/functors/payload:module",
        "//pipeline-service/modules/ng-triggers/src/main/java/io/harness/ngtriggers/helpers:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/plan/service:module",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_validation_validation_api",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
