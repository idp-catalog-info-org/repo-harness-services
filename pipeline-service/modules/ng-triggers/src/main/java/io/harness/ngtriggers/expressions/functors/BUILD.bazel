    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/pms/execution/utils:module",
        "//952-scm-java-client/src/main/java/io/harness/beans:module",
        "//953-yaml-commons/src/main/java/io/harness/yaml/utils:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/expression:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/ng-triggers/contracts/src/main/java/io/harness/ngtriggers:module",
        "//pipeline-service/modules/ng-triggers/src/main/java/io/harness/ngtriggers/helpers:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-beans/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/plan:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/plan/service:module",
        "@maven//:org_apache_commons_commons_lang3",
