    deps = [
        "//:lombok",
        "//959-ng-persistence/src/main/java/io/harness/mongo/iterator/filter:module",
        "//959-ng-persistence/src/main/java/io/harness/mongo/iterator/provider:module",
        "//960-persistence/src/main/java/io/harness/elasticsearch:module",
        "//960-persistence/src/main/java/io/harness/elasticsearch/framework:module",
        "//960-persistence/src/main/java/io/harness/elasticsearch/utils:module",
        "//960-persistence/src/main/java/io/harness/iterator:module",
        "//960-persistence/src/main/java/io/harness/lock/interfaces:module",
        "//960-persistence/src/main/java/io/harness/mongo/iterator:module",
        "//960-persistence/src/main/java/io/harness/mongo/iterator/pojos:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/dataretention:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/search/entity:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/search/entity/beans:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/search/service:module",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_annotation_javax_annotation_api",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
