    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//960-persistence/src/main/java/io/harness/elasticsearch:module",
        "//960-persistence/src/main/java/io/harness/objectstore:module",
        "//960-persistence/src/main/java/io/harness/objectstore/beans:module",
        "//980-commons/src/main/java/io/harness/threading:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/dataretention/config:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/dataretention/jobs/service:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/dataretention/jobs/service/impl:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/dataretention/service:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/dataretention/service/impl:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/reconciliation/service:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/reconciliation/service/impl:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/search/service:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/search/service/impl:module",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_metrics_metrics_core",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
