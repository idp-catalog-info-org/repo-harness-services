load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//pipeline-service:__subpackages__"],
    deps = [
        "//:lombok",
        "//878-ng-common-utilities/src/main/java/io/harness/utils:module",
        "//956-feature-flag-beans/src/main/java/io/harness/beans:module",
        "//960-persistence/src/main/java/io/harness/objectstore:module",
        "//980-commons/src/main/java/io/harness/data/structure:module",
        "//980-commons/src/main/java/io/harness/exception:module",
        "//980-commons/src/main/java/io/harness/maintenance:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/dataretention/config:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/dataretention/entity:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/dataretention/entity/beans:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/dataretention/service:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/dataretention/utils:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/repositories/dataretention:module",
        "@maven//:com_google_cloud_google_cloud_storage",
        "@maven//:com_google_inject_guice",
        "@maven//:javax_annotation_javax_annotation_api",
        "@maven//:joda_time_joda_time",
        "@maven//:org_mongodb_mongo_java_driver",
        "@maven//:org_springframework_data_spring_data_mongodb",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
