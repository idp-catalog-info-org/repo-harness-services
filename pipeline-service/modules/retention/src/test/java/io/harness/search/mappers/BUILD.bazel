        "//953-yaml-commons/src/main/java/io/harness/yaml/core:module",
        "//970-ng-commons/src/main/java/io/harness/gitsync/beans:module",
        "//970-ng-commons/src/main/java/io/harness/gitsync/sdk:module",
        "//970-ng-commons/src/main/java/io/harness/ng/core/common/beans:module",
        "//990-commons-test/src/main/java/io/harness:module",
        "//990-commons-test/src/main/java/io/harness/category/element:module",
        "//990-commons-test/src/main/java/io/harness/rule:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-visualization/contracts:module",
        "//pipeline-service/modules/orchestration/contracts:module",
        "//pipeline-service/modules/pms-contracts/src/main/proto:pms_contracts_proto",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/search/entity/beans:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/search/entity/beans/cd:module",
        "//pipeline-service/modules/retention/contracts/src/main/java/io/harness/search/entity/beans/ci:module",
