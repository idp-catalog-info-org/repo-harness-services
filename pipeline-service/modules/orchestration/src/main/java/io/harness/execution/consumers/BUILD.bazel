load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/pms/events/base:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/api:module",
        "//953-events-api/src/main/proto:953_events_api_java_proto",
        "//960-persistence/src/main/java/io/harness/queue:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//clients/pipeline-service/pms-sdk/src/main/java/io/harness/pms/sdk/execution/events:module",
        "//kafka-client/src/main/java/io/harness/kafka/consumers:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/constants:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/execution/consumers/flowgovernor:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/execution:module",
        "@maven//:com_google_inject_guice",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:javax_cache_cache_api",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
