        "//960-persistence/src/main/java/io/harness/lock/interfaces:module",
        "//970-ng-commons/src/main/java/io/harness/metrics/service/api:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/monitoring:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/concurrency/counter:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/concurrency/queue:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/engine/executions/node/helper:module",
