load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/monitoring:module",
        "//884-pms-commons/src/main/java/io/harness/pms/events/base:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/api:module",
        "//953-events-api/src/main/proto:953_events_api_java_proto",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//kafka-client/src/main/java/io/harness/kafka/common:module",
        "//kafka-client/src/main/java/io/harness/kafka/config:module",
        "//kafka-client/src/main/java/io/harness/kafka/consumers:module",
        "//kafka-client/src/main/java/io/harness/kafka/logging:module",
        "//kafka-client/src/main/java/io/harness/kafka/producers:module",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_github_ben_manes_caffeine_caffeine",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_github_resilience4j_resilience4j_core",
        "@maven//:io_github_resilience4j_resilience4j_ratelimiter",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven_redisson//:org_redisson_redisson",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
