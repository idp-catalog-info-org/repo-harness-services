load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//955-outbox-sdk/src/main/java/io/harness/outbox:module",
        "//955-outbox-sdk/src/main/java/io/harness/outbox/api:module",
        "//955-outbox-sdk/src/main/java/io/harness/outbox/eventpoll:module",
        "//955-outbox-sdk/src/main/java/io/harness/outbox/monitor:module",
        "//960-persistence/src/main/java/io/harness/lock/interfaces:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/outbox/src/main/java/io/harness:module",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_dropwizard_lifecycle",
        "@maven//:io_github_resilience4j_resilience4j_core",
        "@maven//:io_github_resilience4j_resilience4j_retry",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
