    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//955-outbox-sdk/src/main/java/io/harness/outbox:module",
        "//955-outbox-sdk/src/main/java/io/harness/outbox/api:module",
        "//955-outbox-sdk/src/main/java/io/harness/outbox/api/impl:module",
        "//955-outbox-sdk/src/main/java/io/harness/outbox/filter:module",
        "//960-persistence/src/main/java/io/harness/utils:module",
        "//970-ng-commons/src/main/java/io/harness/constants:module",
        "//970-ng-commons/src/main/java/io/harness/event:module",
        "//970-ng-commons/src/main/java/io/harness/ng/beans:module",
        "//970-ng-commons/src/main/java/io/serializer/mapper:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/outbox/src/main/java/io/harness:module",
        "//pipeline-service/modules/outbox/src/main/java/io/harness/api:module",
        "//pipeline-service/modules/outbox/src/main/java/io/harness/repositories:module",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_inject_guice",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_data_spring_data_mongodb",
        "@maven//:org_springframework_spring_core",
    ],
