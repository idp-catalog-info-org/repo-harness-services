{
  "type": "record",
  "name": "StageEventAvro",
  "namespace": "io.harness.pms.contracts.execution",
  "fields": [
    { "name": "level", "type": "string" },
    { "name": "accountIdentifier", "type": "string" },
    { "name": "orgIdentifier", "type": "string" },
    { "name": "projectIdentifier", "type": "string" },
    { "name": "parentUniqueId", "type": ["null", "string"], "default": null },
    { "name": "pipelineIdentifier", "type": "string" },
    { "name": "pipelineName", "type": "string" },
    { "name": "planExecutionId", "type": "string" },
    { "name": "executionUrl", "type": "string" },
    { "name": "stageExecutionId", "type": "string" },
    { "name": "stageIdentifier", "type": "string" },
    { "name": "stageName", "type": ["null", "string"], "default": null },
    { "name": "stageType", "type": ["null", "string"], "default": null },
    { "name": "status", "type": "string" },
      { "name": "eventType", "type": ["null", "string"], "default": null },
    { "name": "createdAt", "type": "string" },
    { "name": "startTs", "type": "string" },
    { "name": "lastModifiedAt", "type": "string" },
    { "name": "endTs", "type": "string" },
    { "name": "duration", "type": "string" },
    {
      "name": "failureInfo",
      "type": [
        "null",
        {
          "type": "record",
          "name": "FailureInfoAvro",
          "fields": [
            {
              "name": "failureData",
              "type": [
                "null",
                {
                  "type": "array",
                  "items": {
                    "type": "record",
                    "name": "FailureDataAvro",
                    "fields": [
                      { "name": "code", "type": ["null", "string"], "default": null },
                      { "name": "level", "type": ["null", "string"], "default": null },
                      { "name": "message", "type": ["null", "string"], "default": null },
                      { "name": "failureType", "type": ["null", "string"], "default": null },
                      { "name": "failureSubType", "type": ["null", "string"], "default": null }
                    ]
                  }
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "moduleInfo",
      "type": [
        "null",
        {
          "type": "record",
          "name": "ModuleInfo",
          "fields": [
            {
              "name": "cd",
              "type": [
                "null",
                {
                  "type": "record",
                  "name": "CDInfo",
                  "fields": [
                    { "name": "envRef", "type": ["null", "string"], "default": null },
                    { "name": "infra", "type": ["null", "string"], "default": null },
                    { "name": "service", "type": ["null", "string"], "default": null },
                    { "name": "artifactVersion", "type": ["null", "string"], "default": null }
                  ]
                }
              ],
              "default": null
            },
            {
              "name": "ci",
              "type": [
                "null",
                {
                  "type": "record",
                  "name": "CIInfo",
                  "fields": []
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    }
    ,
    { "name": "failureInfoJson", "type": ["null", "string"], "default": null }
  ]
}
