    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//440-connector-nextgen/src/main/java/io/harness/serializer/kryo:module",
        "//920-delegate-service-beans/src/main/java/io/harness/serializer/kryo:module",
        "//930-delegate-tasks/src/main/java/io/harness/serializer:module",
        "//959-common-entities/src/main/java/io/harness/serializer/kryo:module",
        "//980-commons/src/main/java/io/harness/morphia:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-visualization/contracts/src/main/java/io/harness/serializer/kryo:module",
        "//pipeline-service/modules/orchestration-visualization/contracts/src/main/java/io/harness/serializer/morphia:module",
        "//pipeline-service/modules/orchestration/src/main/java/io/harness/serializer:module",
        "//pipeline-service/modules/retention/src/main/java/io/harness/serializer:module",
        "@maven//:com_google_guava_guava",
        "@maven//:org_springframework_spring_core",
