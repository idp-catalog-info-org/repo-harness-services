load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//953-events-api/src/main/java/io/harness/eventsframework:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/api:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/impl/noop:module",
        "//953-events-api/src/main/java/io/harness/eventsframework/impl/redis:module",
        "//960-persistence/src/main/java/io/harness/redis:module",
        "//980-commons/src/main/java/io/harness/authorization:module",
        "//980-commons/src/main/java/io/harness/threading:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/service:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/service/impl:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/skip/service:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/skip/service/impl:module",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_metrics_metrics_core",
        "@maven//:org_jooq_jooq",
        "@maven_redisson//:org_redisson_redisson",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
