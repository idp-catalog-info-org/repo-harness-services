load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//kafka-client/src/main/java/io/harness/kafka/config:module",
        "//pipeline-service/modules/orchestration-visualization/contracts/src/main/java/io/harness/beans:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/event/streams/model:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/event/streams/serde:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/graph/consumer:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/graph/service:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/graph/service/impl:module",
        "@maven//:com_google_inject_guice",
        "@maven//:io_dropwizard_dropwizard_lifecycle",
        "@maven//:org_apache_kafka_kafka_clients",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
