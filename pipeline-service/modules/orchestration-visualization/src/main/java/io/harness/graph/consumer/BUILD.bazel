        "//kafka-client/src/main/java/io/harness/kafka/config:module",
        "//kafka-client/src/main/java/io/harness/kafka/producers:module",
        "//pipeline-service/modules/orchestration-visualization/src/main/java/io/harness/event/streams/model:module",
