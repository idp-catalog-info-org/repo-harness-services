load("@rules_java//java:defs.bzl", "java_library")
load("//:tools/bazel/macros.bzl", "run_analysis_per_module")

java_library(
    name = "module",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:lombok",
        "//884-pms-commons/src/main/java/io/harness/pms/data:module",
        "//884-pms-commons/src/main/java/io/harness/pms/utils:module",
        "//920-delegate-service-beans/src/main/java/io/harness/delegate/beans:module",
        "//980-commons/src/main/java/io/harness/eraro:module",
        "//999-annotations/src/main/java/io/harness/annotations/dev:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/execution:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/interrupts:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/pms/data/stepdetails:module",
        "//pipeline-service/modules/orchestration-beans/contracts/src/main/java/io/harness/pms/data/stepparameters:module",
        "//pipeline-service/modules/orchestration-visualization/contracts/src/main/java/io/harness/beans/internal:module",
        "//pipeline-service/modules/orchestration-visualization/contracts/src/main/java/io/harness/beans/strategy:module",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
    ],
)

run_analysis_per_module(
    checkstyle_srcs = glob(["*"]),
    pmd_srcs = glob(["*"]),
    sonarqube_srcs = glob(["*"]),
)
